{
  "name": "bookreader",
  "productName": "BookReader",
  "version": "0.1.0",
  "description": "Livres audio locaux avec XTTS-v2",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "setup:web": "npm --prefix web ci",
    "build:web": "npm --prefix web run build",
    "pack": "npm run build:web && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.ylupien.bookreader",
    "productName": "BookReader",
    "directories": { "output": "dist" },
    "files": ["desktop/**/*", "package.json"],
    "extraResources": [
      { "from": "server", "to": "server", "filter": ["**/*", "!**/__pycache__/**", "!tests/**"] },
      { "from": "build/icon.png", "to": "icon.png" }
    ],
    "win": { "target": "dir", "signAndEditExecutable": false },
    "asar": true
  }
}
